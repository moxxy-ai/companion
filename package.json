{
  "name": "companion",
  "private": true,
  "version": "0.1.0",
  "description": "Companion — a maintainer's GUI that manages a GitHub repository with moxxy agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter companiond --filter companion-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prod": "pnpm -r build && pm2 startOrRestart ecosystem.config.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
