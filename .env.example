# Companion authentication — copy to .env (repo root or ~/.companion/.env).
# Precedence: real environment > ./.env > ~/.companion/.env.
# These accounts are SEEDS: imported once into an empty user store, after
# which the Users admin module owns accounts. A clean setup without any .env
# credentials runs first-boot onboarding in the browser instead.
# An account is seeded only when BOTH its USER and PASSWORD are set.

# Admin — full access (settings, workspaces, everything below).
COMPANION_ADMIN_USER=admin
COMPANION_ADMIN_PASSWORD=change-me

# Maintainer — day-to-day operation: issues, PRs, proposals, pipelines,
# runs, automations. No instance settings / workspace lifecycle.
#COMPANION_MAINTAINER_USER=maintainer
#COMPANION_MAINTAINER_PASSWORD=change-me

# Business — proposals only (create, analyze, follow along).
#COMPANION_BUSINESS_USER=business
#COMPANION_BUSINESS_PASSWORD=change-me

# Optional overrides.
#COMPANION_PORT=8901
# Bind host. Defaults to 127.0.0.1 for local runs; Docker Compose sets 0.0.0.0.
#COMPANION_HOST=127.0.0.1
# Model every agent run uses by default.
#COMPANION_MODEL=gpt-5.5
