{
  "name": "@companion/module-refinement",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./manifest": { "types": "./dist/module.d.ts", "default": "./dist/module.js" },
    "./contract": { "source": "./src/contract/index.ts", "types": "./dist/contract/index.d.ts", "default": "./dist/contract/index.js" },
    "./api":      { "types": "./dist/api/index.d.ts", "default": "./dist/api/index.js" },
    "./client":   { "source": "./src/client/index.tsx" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@companion/core": "workspace:*",
    "@companion/contracts": "workspace:*",
    "@companion/services": "workspace:*",
    "@companion/types": "workspace:*",
    "@companion/ui": "workspace:*",
    "@companion/module-core": "workspace:*",
    "@companion/module-workspace": "workspace:*",
    "@companion/module-code": "workspace:*",
    "@companion/module-operate": "workspace:*",
    "@companion/module-plan": "workspace:*",
    "@companion/module-board": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "better-sqlite3": "^12.2.0",
    "react": "^18.3.1",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
