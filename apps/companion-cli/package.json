{
  "name": "@moxxy/companion",
  "version": "0.17.0",
  "description": "A local-first control plane for software teams and AI agents.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "companion": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "github",
    "ai",
    "agents",
    "dashboard",
    "self-hosted",
    "automation",
    "code-review",
    "moxxy"
  ],
  "scripts": {
    "build": "node build.mjs",
    "bundle": "pnpm --dir ../.. gen:modules && pnpm run bundle:prepared",
    "bundle:full": "pnpm --dir ../.. gen:modules --profile full && pnpm run bundle:prepared",
    "bundle:prepared": "pnpm --filter 'companion-api...' build && pnpm --filter companion-web build && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run bundle && node --test tests/*.test.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run bundle:full && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "undici": "^8.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@companion/module-workbench": "workspace:*",
    "@moxxy/companion-core": "workspace:*",
    "@companion/module-core": "workspace:*",
    "@moxxy/companion-services": "workspace:*",
    "@types/node": "^24.13.3",
    "companion-api": "workspace:*",
    "companion-web": "workspace:*",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/moxxy-ai/companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/companion.git",
    "directory": "apps/companion-cli"
  },
  "bugs": {
    "url": "https://github.com/moxxy-ai/companion/issues"
  }
}
