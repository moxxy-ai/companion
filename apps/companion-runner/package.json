{
  "name": "@moxxy/companion-runner",
  "version": "0.14.0",
  "description": "Companion runner agent \u2014 execute Companion's AI agent work (moxxy gateways, git worktrees, PRs) on any machine, driven by a companiond over HTTP+WebSocket.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "companion-runner": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "moxxy",
    "companion",
    "agent",
    "runner",
    "ci",
    "automation"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@moxxy/cli": "*"
  },
  "peerDependenciesMeta": {
    "@moxxy/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@companion/module-operate": "workspace:*",
    "@moxxy/companion-runtime": "workspace:*",
    "@moxxy/companion-services": "workspace:*",
    "@moxxy/companion-types": "workspace:*",
    "@moxxy/plugin-tunnel-proxy": "^0.36.1",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/companion.git",
    "directory": "apps/companion-runner"
  }
}
