{
  "name": "@moxxy/companion-sdk",
  "version": "0.10.0",
  "description": "The public module-authoring surface for Companion.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./client": {
      "source": "./src/client.tsx",
      "types": "./dist/types/client.d.ts"
    },
    "./ui": {
      "source": "./src/ui.ts",
      "types": "./dist/types/ui.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/index.ts",
    "src/client.tsx",
    "src/ui.ts"
  ],
  "keywords": [
    "github",
    "ai",
    "agents",
    "moxxy",
    "sdk",
    "modules"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@moxxy/companion-core": "workspace:^",
    "@moxxy/companion-services": "workspace:^",
    "@moxxy/companion-types": "workspace:^",
    "@moxxy/companion-ui": "workspace:^"
  },
  "devDependencies": {
    "@moxxy/companion-contracts": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@moxxy/companion-contracts": "^0.7.0",
    "react": "^19.2.8"
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/moxxy-ai/companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/companion.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/moxxy-ai/companion/issues"
  }
}
