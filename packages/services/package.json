{
  "name": "@moxxy/companion-services",
  "version": "0.10.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@moxxy/companion-contracts": "workspace:*",
    "@moxxy/companion-types": "workspace:*",
    "jsonrepair": "^3.15.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "description": "Internal Companion framework package. Modules import @moxxy/companion-sdk instead.",
  "keywords": [
    "github",
    "ai",
    "agents",
    "moxxy",
    "services"
  ],
  "homepage": "https://github.com/moxxy-ai/companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/companion.git",
    "directory": "packages/services"
  },
  "bugs": {
    "url": "https://github.com/moxxy-ai/companion/issues"
  }
}
